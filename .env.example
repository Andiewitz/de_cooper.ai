# de_cooper.ai — Monorepo Environment Variables Template
# Copy this file to server/.env or configure these variables in your Railway Dashboard.

# ==========================================
# 1. Database Configuration
# ==========================================
# Production: Add a Railway PostgreSQL database. Railway will automatically inject this.
# Local development: Falls back to a local SQLite database (decooper.db) if empty or unset.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/decooper

# ==========================================
# 2. AI & Sheldon Cooper LLM Configuration
# ==========================================
# Obtain your key from https://openrouter.ai/
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct

# ==========================================
# 3. Security & Authentication
# ==========================================
# Secure random string for signing JWT access tokens (generate with: openssl rand -hex 32)
SECRET_KEY=dev-secret-key-change-this-in-production-use-a-real-secret-key

# ==========================================
# 4. Google OAuth & Native One Tap Sign-In
# ==========================================
# Obtain these from your Google Cloud Console -> APIs & Services -> Credentials
# Required for real Google Auth to work. If left blank, the app runs in interactive demo mode.
GOOGLE_CLIENT_ID=your-google-oauth-client-id-here
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-oauth-client-id-here

# ==========================================
# 5. Network & Dev Configuration
# ==========================================
# CORS Origins (JSON list format)
CORS_ORIGINS=["http://localhost:3000"]
DEBUG=true
PORT=8000
